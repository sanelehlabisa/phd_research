@article{residual_attention_convlstm2023,
  author = {Patil, A. and others},
  title = {Abnormal Activity Recognition with Residual Attention-Based ConvLSTM},
  journal = {International Journal of Intelligent Engineering and Systems},
  volume = {16},
  number = {6},
  year = {2023},
  doi = {10.22266/ijies2023.1231.60},
  abstract  = {
    Introduction {
      - Standard LSTM cannot capture spatial information between consecutive frames
      - Residual attention added to ConvLSTM to focus on relevant regions
    }
    Problem Statement {
      - Vanilla ConvLSTM weights all spatial positions equally; violent regions may be small
    }
    Proposed Method {
      - Residual attention module inserted into ConvLSTM cell
      - Clips of 16 frames evaluated on Hockey Fight dataset
    }
    Experimental Results {
      - Binary classification accuracy 89% on Hockey Fight dataset
    }
    Strengths {
      - Attention mechanism improves focus on localised activity regions
      - Still lightweight relative to transformer alternatives
    }
    Weaknesses {
      - Only binary classification evaluated
      - Hockey Fight is a controlled dataset; may not transfer to real surveillance
    }
    Key Takeaways {
      - Spatial attention is a natural extension of our ConvLSTM work
      - 89% on Hockey Fight is a useful comparison point for violence detection
    }
  }
}

@article{kumar2024fuzzy,
  author = {Kumar, M. and Biswas, M.},
  title = {Abnormal Human Activity Detection by Convolutional Recurrent Neural Network Using Fuzzy Logic},
  journal = {Multimedia Tools and Applications},
  volume = {83},
  pages = {61843--61859},
  year = {2024},
  doi = {10.1007/s11042-023-15904-x},
  abstract = {
    Introduction {
      - Combines CNN+RNN with fuzzy logic for uncertainty handling in activity detection
    }
    Problem Statement {
      - Hard class boundaries in activity classifiers fail when activities are visually similar
    }
    Proposed Method {
      - CNN feature extractor -> RNN temporal model -> Fuzzy logic post-processing for soft decisions
      - Transfer learning from pretrained CNN backbone
    }
    Experimental Results {
      - Improved accuracy on ambiguous activity pairs compared to hard-boundary classifiers
    }
    Strengths {
      - Handles inter-class visual similarity better than standard softmax
      - Transfer learning reduces data requirements
    }
    Weaknesses {
      - Fuzzy logic adds inference latency
      - Unclear benefit when classes are well separated
    }
    Key Takeaways {
      - Useful citation for discussion of ambiguous class pairs (e.g. Fight vs Harassment)
      - Transfer learning from larger datasets helps on small surveillance sets
    }
  }
}

