@article{vrskova2023_3dcnn_convlstm,
  author = {Vrskova, R. and Hudec, R. and Kamencay, P. and Sykora, P.},
  title = {A New Deep-Learning Method for Human Activity Recognition},
  journal = {Applied Sciences},
  volume = {13},
  number = {5},
  pages = {3275},
  year = {2023},
  doi = {10.3390/app13053275},
  abstract = {
    Introduction {
      - Combines 3DCNN and ConvLSTM to leverage both spatial and temporal strengths
    }
    Problem Statement {
      - Neither pure 3DCNN nor pure ConvLSTM fully captures all spatiotemporal dependencies
    }
    Proposed Method {
      - Hybrid 3DCNN + ConvLSTM model
      - Evaluated on LoDVP, UCF50, MOD20
    }
    Experimental Results {
      - Improved over standalone ConvLSTM on some metrics
      - UCF50: high accuracy
    }
    Strengths {
      - Captures both fine-grained spatial and long-range temporal patterns
      - Broader dataset coverage than prior work
    }
    Weaknesses {
      - More complex to train and tune than standalone models
      - Higher inference cost
    }
    Key Takeaways {
      - Hybrid architectures can outperform single-family models
      - Useful citation to motivate why temporal modelling matters alongside spatial
    }
  }
}

