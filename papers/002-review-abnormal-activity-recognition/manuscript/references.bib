@inproceedings{soomro2012ucf101,
  author = {Soomro, K. and Zamir, A. R. and Shah, M.},
  title = {UCF101: A Dataset of 101 Human Actions Classes From Videos in the Wild},
  booktitle = {arXiv preprint arXiv:1212.0402},
  year = {2012},
  abstract = {
    Introduction {
      - Large-scale action recognition benchmark covering 101 diverse human action classes
    }
    Problem Statement {
      - Earlier datasets (KTH, HMDB) too small and controlled for real-world generalisation
    }
    Proposed Method {
      - 13,320 YouTube clips across 101 classes collected in the wild
    }
    Experimental Results {
      - Widely used benchmark; top models now exceed 99% accuracy
    }
    Strengths {
      - Diverse backgrounds, viewpoints, lighting
      - Large scale enables pretraining
    }
    Weaknesses {
      - General action classes; most are not surveillance-relevant anomalies
      - Web-sourced; not representative of surveillance camera footage
    }
    Key Takeaways {
      - Not used for AHAR evaluation but relevant as general HAR context
      - Useful citation when discussing general video understanding vs anomaly detection
    }
  }
}

@article{xingjian2015convlstm,
  author = {Shi, X. and Chen, Z. and Wang, H. and Yeung, D.-Y. and Wong, W.-K. and Woo, W.-C.},
  title = {Convolutional LSTM Network: A Machine Learning Approach for Precipitation Nowcasting},
  journal = {NeurIPS},
  year = {2015},
  abstract = {
    Introduction {
      - Introduced ConvLSTM: replaces fully connected operations in LSTM with convolutions
    }
    Problem Statement {
      - Standard LSTM loses spatial structure; 3D CNN cannot model long-range temporal dependencies
    }
    Proposed Method {
      - ConvLSTM cell: input, forget, cell, output gates all computed via convolution
      - Proposed for spatiotemporal prediction (precipitation nowcasting)
    }
    Experimental Results {
      - Outperformed FC-LSTM and ROVER on precipitation nowcasting
    }
    Strengths {
      - Preserves spatial structure while modelling temporal dynamics
      - Foundation of all ConvLSTM-based activity recognition work
    }
    Weaknesses {
      - Sequential computation limits parallelism
      - Memory intensive for long sequences
    }
    Key Takeaways {
      - Foundational paper for our entire model family
      - Must cite when introducing ConvLSTM architecture
    }
  }
}

@inproceedings{sultani2018,
  author={Sultani, Waqas and Chen, Chen and Shah, Mubarak},
  title={Real-World Anomaly Detection in Surveillance Videos},
  booktitle={Proceedings of the IEEE/CVF Conference on Computer Vision and Pattern Recognition},
  year={2018},
  pages={6479--6488},
  doi={10.1109/CVPR.2018.00678},
  abstract={
    Introduction {
      - First large-scale weakly-supervised anomaly detection benchmark from real surveillance
    }
    Problem Statement {
      - Existing datasets are staged; real-world anomalies are rare and diverse
    }
    Proposed Method {
      - UCF-Crime: 1900 surveillance videos, 13 anomaly classes + normal
      - Multiple Instance Learning (MIL) with C3D features for weakly supervised detection
    }
    Experimental Results {
      - AUC 75.41% on UCF-Crime with MIL baseline
      - Significantly harder than staged datasets
    }
    Strengths {
      - Real-world, untrimmed surveillance videos
      - Gold standard benchmark for AHAR
      - Covers crimes: Abuse, Arrest, Arson, Assault, Burglary, Explosion, Fighting, etc.
    }
    Weaknesses {
      - Weak labels only (video-level); no temporal annotations
      - Imbalanced classes
    }
    Key Takeaways {
      - UCF-Crime is the primary benchmark for surveillance anomaly detection
      - Our class vocabulary is aligned with UCF-Crime categories
    }
  }
}

@inproceedings{tran2018closer,
  author = {Tran, D. and Wang, H. and Torresani, L. and Ray, J. and LeCun, Y. and Paluri, M.},
  title = {A Closer Look at Spatiotemporal Convolutions for Action Recognition},
  booktitle = {CVPR},
  year = {2018},
  abstract = {
    Introduction {
      - Investigates different factorisation strategies for 3D convolutions in video CNNs
    }
    Problem Statement {
      - Full 3D convolutions are expensive; how to best factor space and time?
    }
    Proposed Method {
      - Compares: C3D, R3D, MC3 (mixed 2D/3D), R(2+1)D (factorised spatiotemporal)
      - R(2+1)D decomposes 3D conv into separate 2D spatial + 1D temporal convs
    }
    Experimental Results {
      - R(2+1)D outperforms C3D and R3D on Kinetics and Sports-1M
      - MC3 is competitive with lower cost
    }
    Strengths {
      - Factorised convolutions reduce parameters while maintaining accuracy
      - Pretrained weights widely available in torchvision
    }
    Weaknesses {
      - Still 31M+ parameters for ResNet-18 scale
      - Pretrained on Kinetics (general actions); domain gap with surveillance data
    }
    Key Takeaways {
      - ResNet-R2Plus1D and ResNet-MC3 are our 3D CNN baselines
      - Domain gap explains their underperformance vs ConvLSTM on surveillance data
    }
  }
}

@inproceedings{hara2018resnet3d,
  author = {Hara, K. and Kataoka, H. and Satoh, Y.},
  title = {Can Spatiotemporal 3D CNNs Retrace the History of 2D CNNs?},
  booktitle = {CVPR},
  year = {2018},
  abstract = {
    Introduction {
      - Investigates whether 3D ResNet architectures replicate 2D ResNet success on video
    }
    Problem Statement {
      - No systematic comparison of 3D ResNet depths on video benchmarks existed
    }
    Proposed Method {
      - 3D ResNet-18/34/50/101/152 evaluated on Kinetics, UCF101, HMDB51
      - ResNet3D-18 is the standard lightweight variant
    }
    Experimental Results {
      - Deeper models improve on Kinetics; ResNet3D-18 is competitive for smaller datasets
      - 33M parameters for ResNet3D-18
    }
    Strengths {
      - Well-studied architecture family with pretrained weights
      - Scalable depth
    }
    Weaknesses {
      - High parameter count even at ResNet-18 scale
      - Overfits on small surveillance datasets without strong regularisation
    }
    Key Takeaways {
      - ResNet3D-18 is our heaviest 3D CNN baseline at 33M params
      - Our proposed model at 1.28M outperforms it on surveillance data
    }
  }
}

