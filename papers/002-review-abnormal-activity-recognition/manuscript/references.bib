@article{vrskova2022,
  author={Vrskova, R. and Hudec, R. and Kamencay, P. and Sykora, P.},
  title={A New Approach for Abnormal Human Activities Recognition Based on ConvLSTM Architecture},
  journal={Sensors},
  volume={22},
  number={8},
  pages={2946},
  year={2022},
  doi={10.3390/s22082946},
  abstract = {
    Introduction {
      - Recognising abnormal human activities from surveillance video is challenging
      - Lack of datasets containing varied abnormal behaviours motivated this work
    }
    Problem Statement {
      - Existing datasets focus on general HAR; few cover surveillance-specific anomalies
      - Short event duration (a few seconds) makes temporal modelling difficult
    }
    Proposed Method {
      - ConvLSTM: TimeDistributed Conv2D(16) -> ConvLSTM2D(64) -> BN -> Conv2D(16) -> Dense(256)
      - Trained on self-created LoDVP Abnormal Activities Dataset (11 classes, 1069 videos)
      - Also evaluated on AIRTLab dataset (2 classes, 350 clips)
    }
    Experimental Results {
      - LoDVP dataset: ~96% accuracy
      - AIRTLab dataset: competitive vs CNN, 3DCNN baselines
      - Metrics: Accuracy, Confusion Matrix
    }
    Strengths {
      - Combines spatial (CNN) and temporal (LSTM) modelling in one pass
      - Lightweight compared to 3D CNN variants
      - Released LoDVP dataset publicly
    }
    Weaknesses {
      - ~4M parameters still large for edge deployment
      - Overfits on small datasets (AIRTLab: 350 videos)
      - No precision/recall/F1 reported
      - Single dataset evaluation limits generalisability
    }
    Key Takeaways {
      - ConvLSTM is strong baseline for surveillance AHAR
      - Dataset size critically affects performance — need regularisation on small sets
      - TimeDistributed convolution is an effective lightweight spatial encoder
    }
  }
}

@article{vrskova2022_3dcnn,
  author = {Vrskova, R. and Hudec, R. and Kamencay, P. and Sykora, P.},
  title = {Human Activity Classification Using the 3DCNN Architecture},
  journal = {Applied Sciences},
  volume = {12},
  number = {2},
  pages = {931},
  year = {2022},
  doi = {10.3390/app12020931},
  abstract = {
    Introduction {
      - 3D CNNs are dominant in video-based HAR due to joint spatiotemporal processing
    }
    Problem Statement {
      - 3D CNNs are computationally expensive and prone to overfitting on small datasets
    }
    Proposed Method {
      - 3DCNN evaluated on LoDVP and UCF datasets
      - Standard ResNet3D-style architecture adapted for surveillance clips
    }
    Experimental Results {
      - Competitive accuracy on LoDVP but higher parameter count than ConvLSTM
      - Higher FLOPs per forward pass
    }
    Strengths {
      - Strong spatial feature extraction
      - Mature ecosystem (pretrained weights available)
    }
    Weaknesses {
      - High parameter count limits real-time feasibility
      - Degrades more than ConvLSTM on small VDD dataset
    }
    Key Takeaways {
      - 3DCNN is a strong but heavy baseline; ConvLSTM offers better accuracy/param tradeoff on surveillance data
    }
  }
}

