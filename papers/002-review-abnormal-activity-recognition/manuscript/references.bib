@article{talukder2024cnn_convlstm_lrcn,
  author = {Talukder, M. A. and others},
  title = {Deep Learning-Based Human Activity Recognition Using CNN, ConvLSTM, and LRCN},
  journal = {Results in Engineering},
  year = {2024},
  doi = {10.1016/j.rineng.2024.102555},
  abstract = {
    Introduction {
      - Compares CNN, ConvLSTM, and LRCN for HAR from video and sensor data
      - Motivated by patient monitoring and healthcare applications
    }
    Problem Statement {
      - No systematic comparison of these three architectures across modalities
    }
    Proposed Method {
      - CNN: static frame classification
      - ConvLSTM: spatiotemporal from video frames
      - LRCN: CNN features passed to LSTM
      - Evaluated on WISDM (accelerometer) and video-based datasets
    }
    Experimental Results {
      - ConvLSTM and LRCN both outperform CNN on temporal activities
      - Sensor data accuracy varies significantly across subjects
    }
    Strengths {
      - Covers both sensor and camera modalities in one study
      - Practical healthcare motivation
    }
    Weaknesses {
      - Sensor data requires body-worn devices — scaling and privacy concerns
      - Cross-subject generalisation is poor on WISDM
    }
    Key Takeaways {
      - Sensor-based HAR leaks more private information and is harder to scale for public surveillance
      - Camera-based approaches are more scalable for anomaly detection in public spaces
      - ConvLSTM outperforms LRCN on video modality
    }
  }
}

@article{frontiers_wearable_cnn2024,
  author = {Alosaimi, W. and others},
  title = {Wearable Sensors Based on Artificial Intelligence Models for Human Activity Recognition},
  journal = {Frontiers in Artificial Intelligence},
  volume = {7},
  year = {2024},
  doi = {10.3389/frai.2024.1424190},
  abstract = {
    Introduction {
      - CNN applied per-sensor-type (accelerometer, gyroscope, barometer) for wearable HAR
    }
    Problem Statement {
      - Diverse sensor shapes across devices make single CNN architectures suboptimal
    }
    Proposed Method {
      - Separate CNN branches per sensor modality; fusion at feature level
    }
    Experimental Results {
      - Improved accuracy over single-branch CNN on multi-sensor HAR benchmarks
    }
    Strengths {
      - Handles heterogeneous sensor inputs cleanly
      - Suitable for IoT and healthcare wearables
    }
    Weaknesses {
      - Requires subjects to wear multiple sensors — impractical for unconstrained surveillance
      - Cannot detect visual anomalies (e.g. weapon presence)
    }
    Key Takeaways {
      - Sensor-based HAR is well-suited for constrained personal monitoring
      - For public space abnormal activity detection, camera-based systems are preferable
    }
  }
}

@article{dual_backbone_2025,
  author = {Anonymous},
  title = {Recognition of Abnormal Events in Surveillance Videos Using Weakly Supervised Dual-Encoder Models},
  journal = {arXiv preprint},
  year = {2025},
  abstract = {
    Introduction {
      - Combines I3D (CNN) and TimeSformer (Transformer) in a dual-backbone MIL framework
    }
    Problem Statement {
      - Single-modality models miss complementary spatial and temporal cues
    }
    Proposed Method {
      - Dual-backbone: I3D + TimeSformer features fused via top-k pooling
      - Weakly supervised with video-level labels only (no temporal annotations)
      - Evaluated on UCF-Crime
    }
    Experimental Results {
      - 90.7% AUC on UCF-Crime
    }
    Strengths {
      - No temporal annotations required
      - Strong UCF-Crime result
    }
    Weaknesses {
      - Two full backbones — very high inference cost
      - Weakly supervised; no clip-level labels
    }
    Key Takeaways {
      - Recent 2025 result on UCF-Crime; useful to cite as upper bound comparison
      - Confirms that ensemble approaches improve but at high cost
    }
  }
}

@article{bidirectional_convlstm2025,
  author = {Shenoy, M. A. and Thillaiarasu, N.},
  title = {Bi-Directional ConvLSTM Networks for Early Recognition of Human Activities and Action Prediction},
  journal = {Scientific Reports},
  year = {2025},
  doi = {10.1038/s41598-025-22898-z},
  abstract = {
    Introduction {
      - Early activity recognition requires modelling both past and future context
      - Bi-directional LSTM processes sequences in both temporal directions
    }
    Problem Statement {
      - Uni-directional temporal models miss future context that disambiguates early-onset activity
    }
    Proposed Method {
      - Bi-directional ConvLSTM processes spatial feature sequences forward and backward
      - Applied to activity initiation detection and prediction
    }
    Experimental Results {
      - Outperforms uni-directional ConvLSTM on early recognition benchmarks
    }
    Strengths {
      - Better temporal context than standard ConvLSTM
      - Natural extension path from existing ConvLSTM work
    }
    Weaknesses {
      - Doubles LSTM computation
      - Not suitable for online/streaming inference without buffering
    }
    Key Takeaways {
      - Bi-directional variant is a direct future work direction for our model
      - Published 2025 — strong recent citation for related work
    }
  }
}

